{
  "name": "raco-brand",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "backend/services/raco-brand/src",
  "projectType": "library",
  "tags": ["raco", "brand"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "backend/services/raco-brand",
        "commands": ["pnpm build"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "backend/services/raco-brand",
        "command": "pnpm test"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "backend/services/raco-brand",
        "command": "pnpm typecheck"
      }
    }
  }
}
