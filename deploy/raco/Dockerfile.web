FROM nginx:stable-alpine
ARG SOURCE_REPOSITORY
LABEL org.opencontainers.image.source=$SOURCE_REPOSITORY
COPY dist/frontend/core-ui/ /usr/share/nginx/html/
COPY dist/frontend/plugins/operation_ui/ /usr/share/nginx/html/plugins/operation/
COPY dist/frontend/plugins/frontline_ui/ /usr/share/nginx/html/plugins/frontline/
COPY dist/frontend/plugins/sales_ui/ /usr/share/nginx/html/plugins/sales/
COPY dist/apps/frontline-widgets/ /usr/share/nginx/html/widgets/
COPY --chmod=755 deploy/raco/saas/runtime-env.sh /docker-entrypoint.d/40-raco-saas.sh
COPY deploy/raco/nginx.conf /etc/nginx/conf.d/default.conf
# Runtime settings contain only the public, same-origin API route.
RUN mkdir -p /usr/share/nginx/html/js \
    && printf '%s\n' 'window.env={REACT_APP_API_URL:window.location.origin+"/gateway",REACT_APP_WIDGETS_URL:window.location.origin+"/widgets"};' > /usr/share/nginx/html/js/env.js \
    && sed -i '/<head>/a\    <script src="/js/env.js"></script>' /usr/share/nginx/html/index.html \
    && sed -i '/<head>/a\    <script src="/js/env.js"></script>' /usr/share/nginx/html/widgets/index.html \
    && sed -i 's|<base href="/" />|<base href="/widgets/" />|' /usr/share/nginx/html/widgets/index.html \
    && test -s /usr/share/nginx/html/assets/raco-source.tar.gz
EXPOSE 8080
