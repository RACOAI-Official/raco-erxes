# Separate SaaS environment. Do not copy the current single-tenant .env.
VERSION=saas
RACO_SAAS_ENABLED=true
RACO_SAAS_DOMAIN=xos.racoai.io
DOMAIN=https://<subdomain>.xos.racoai.io
MONGO_URL=mongodb://mongo:27017/raco_saas_runtime
CORE_MONGO_URL=mongodb://mongo:27017/raco_saas_control
DB_NAME=erxes_<organizationId>
REDIS_HOST=redis
REDIS_PORT=6379
JWT_TOKEN_SECRET=<generate-a-unique-long-random-secret>
ENABLED_PLUGINS=operation,frontline
ENABLED_SERVICES=automations
# null means pricing unannounced. Checkout stays disabled.
RACO_SAAS_PLANS=[{"id":"standard","name":"Standard","description":"CRM, inbox and AI workflows","monthlyPrice":null,"yearlyPrice":null,"currency":"BDT","seats":5,"features":["Contacts and customer workspaces","Team inbox","AI workflow drafts with human approval"]}]
RACO_SAAS_SMTP_HOST=<smtp-hostname>
RACO_SAAS_SMTP_PORT=587
RACO_SAAS_SMTP_USER=<smtp-user>
RACO_SAAS_SMTP_PASSWORD=<private-secret>
RACO_SAAS_SMTP_FROM=<verified-from-address>
RACO_LLM_BASE_URL=<operator-llm-url>
RACO_LLM_MODEL=qwen3
RACO_LLM_API_KEY=<private-secret>
# No global OpenWA/Mailcow credentials; provision tenant connections separately.

# Payment collection is opt-in. Keep secrets in your private environment.
RACO_SSL_ENABLED=false
RACO_SSL_MODE=sandbox
RACO_SSL_STORE_ID=
RACO_SSL_STORE_PASSWORD=
RACO_SSL_ALLOW_LIVE=false
