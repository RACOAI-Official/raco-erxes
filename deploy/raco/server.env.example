# Keep the real server.env outside Git, mode 600. Never upload the Windows .env.
DOMAIN=https://crm.example.com
MONGO_URL=mongodb://your-private-mongo:27017/erxes?replicaSet=rs0
REDIS_HOST=your-private-redis
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_TOKEN_SECRET=replace-with-a-long-random-secret
RACO_LLM_BASE_URL=https://your-raco-endpoint/v1
RACO_LLM_MODEL=qwen3
RACO_LLM_API_KEY=
RACO_LLM_FALLBACK_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Existing mail transport and file-storage variables belong here as needed.
